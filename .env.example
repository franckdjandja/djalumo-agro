# ---------------------------------------------------------------
# Djalumo Agro · environment variables
# Copy to .env (local) or set them in your hosting dashboard.
# Never commit real values. Only SITE_URL, TURNSTILE_SITE_KEY and
# ANALYTICS_* are used at build time and reach the browser.
# ---------------------------------------------------------------

# Public address of the site, without trailing slash
SITE_URL=https://www.your-domain.com

# PostgreSQL connection string (Neon, Supabase, Railway, RDS, local...)
DATABASE_URL=postgres://user:password@host:5432/djalumo

# Origins allowed to post to /api (comma separated). Leave empty to allow same origin requests only from browsers that omit Origin.
ALLOWED_ORIGINS=https://www.your-domain.com,https://your-domain.com

# Email notifications: resend | brevo | console | none
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Djalumo Agro <notifications@your-domain.com>
# Who receives "New Djalumo Agro website inquiry" and "New Demo Request" (comma separated)
CONTACT_NOTIFICATION_EMAIL=

# Newsletter
NEWSLETTER_NOTIFY=false
NEWSLETTER_SEND_CONFIRMATION=false
# Optional sync to a marketing platform: none | brevo | mailchimp
NEWSLETTER_PROVIDER=none
NEWSLETTER_PROVIDER_KEY=
NEWSLETTER_LIST_ID=

# Cloudflare Turnstile (anti spam). Site key is public, secret key is server only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing client addresses in rate limits (any long random string)
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Minimum time in milliseconds a human needs to fill a form (timing trap)
FORM_MIN_FILL_MS=2500

# Optional analytics, privacy first: plausible (ANALYTICS_ID = your domain) | ga4 (ANALYTICS_ID = G-XXXX)
ANALYTICS_PROVIDER=
ANALYTICS_ID=
