{
  "name": "djalumo-agro-web",
  "version": "1.0.0",
  "private": true,
  "description": "Djalumo Agro: bilingual website, world trade corridor map, field evidence gallery, Season Planner and form backend (contact, demo, newsletter).",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Franck Junior Djandja Tomwa",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/migrate.mjs --if-configured && node site/build.mjs --target=production",
    "build:artifact": "node site/build.mjs --target=artifact",
    "geo": "node scripts/geo.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "dev": "vercel dev",
    "geo:world": "node scripts/geo-world.mjs",
    "photos": "python3 scripts/photos/build_photos.py"
  },
  "dependencies": {
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.15.2",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
