{
  "name": "afrifarm-web",
  "version": "1.0.0",
  "private": true,
  "description": "AfriFarm Intelligent: bilingual website, Season Simulator demo and form backend (contact, demo, newsletter).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/migrate.mjs --if-configured && node site/build.mjs --target=production",
    "build:artifact": "node site/build.mjs --target=artifact",
    "geo": "node scripts/geo.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "dev": "vercel dev"
  },
  "dependencies": {
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
